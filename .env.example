# Required
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_USER_ID=your_telegram_user_id
TENSORX_API_KEY=your_tensorx_api_key          # activates the TensorX provider in opencode

# Optional - Paths
# OPENCODE_PATH=opencode                      # Path to the opencode CLI if not in PATH
# RELAY_DIR=~/.pyclaudius-relay               # Working directory

# Optional - Model
# OPENCODE_MODEL=tensorx/moonshotai/kimi-k3   # provider/model; see 'opencode models'
# OPENCODE_TIMEOUT=300                        # Seconds to wait for one run
# OPENCODE_CONTEXT_LIMIT=1048576              # Used by /context to show a percentage

# Optional - Memory
# MEMORY_ENABLED=true                         # Enable persistent memory
# MAX_MEMORIES=100                            # Max facts to store

# Optional - Cron
# CRON_ENABLED=true                           # Enable scheduled tasks and cron-jobs

# Optional - Tools
# ALLOWED_TOOLS=["webfetch","websearch"]      # Extra opencode tools to allow (lowercase ids)
# OPENCODE_AUTO_APPROVE=false                 # Pass --auto: approves anything not denied

# Optional - Backlog
# BACKLOG_ENABLED=true                        # Save failed prompts for replay (default: true)

# Optional - Email (IMAP)
# EMAIL_ENABLED=true
# EMAIL_IMAP_HOST=imap.gmail.com
# EMAIL_IMAP_PORT=993
# EMAIL_USER=your-llm-email@gmail.com
# EMAIL_PASSWORD=your-app-password

[Unit]
Description=pyclaudius Telegram Bot
# Start after the tmux unit so /tmp/tmux-<UID> exists for BindPaths below.
# Wants, not Requires: the bot still runs if the tmux unit fails or is absent.
After=network-online.target pyclaudius-tmux.service
Wants=network-online.target pyclaudius-tmux.service

[Service]
Type=simple
# UPDATE THIS: Your username
User=YOUR_USERNAME
# UPDATE THIS: Path to project directory
WorkingDirectory=/home/YOUR_USERNAME/pyclaudius
# UPDATE THIS: Path to uv
ExecStart=/home/YOUR_USERNAME/pyclaudius/.venv/bin/pyclaudius
Restart=on-failure
RestartSec=10

# Environment
Environment=HOME=/home/YOUR_USERNAME
Environment=PATH=/home/YOUR_USERNAME/.local/bin:/usr/local/bin:/usr/bin:/bin

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pyclaudius

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/YOUR_USERNAME/.pyclaudius-relay /home/YOUR_USERNAME/.claude /home/YOUR_USERNAME/.local/share/claude
# Lets the TMUX_SESSION keepalive reach the tmux socket through PrivateTmp.
# The leading "-" makes a missing folder non-fatal: /tmp is wiped at boot,
# and without it the unit fails with 226/NAMESPACE until tmux runs.
# YOUR_UID: your numeric UID (id -u); the install sed fills it in.
BindPaths=-/tmp/tmux-YOUR_UID:/tmp/tmux-YOUR_UID
PrivateTmp=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallArchitectures=native
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target

# SETUP INSTRUCTIONS:
#
# 1. Install, replacing YOUR_USERNAME with your login name and YOUR_UID
#    with your UID:
#    sed -e "s/YOUR_USERNAME/$USER/g" -e "s/YOUR_UID/$(id -u)/g" daemon/pyclaudius.service | sudo tee /etc/systemd/system/pyclaudius.service > /dev/null
#
# 2. If you set TMUX_SESSION, also install daemon/pyclaudius-tmux.service
#    (see the instructions in that file). This unit starts after it.
#
# 3. Reload systemd:
#    sudo systemctl daemon-reload
#
# 4. Enable (start on boot):
#    sudo systemctl enable pyclaudius
#
# 5. Start:
#    sudo systemctl start pyclaudius
#
# 6. Check status:
#    sudo systemctl status pyclaudius
#
# 7. View logs:
#    journalctl -u pyclaudius -f
#
# 8. Stop:
#    sudo systemctl stop pyclaudius
#
# 9. Disable:
#    sudo systemctl disable pyclaudius

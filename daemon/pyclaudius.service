[Unit]
Description=pyclaudius Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# UPDATE THIS: Your username
User=YOUR_USERNAME
# UPDATE THIS: Path to project directory
WorkingDirectory=/home/YOUR_USERNAME/pyclaudius
# UPDATE THIS: Path to uv
ExecStart=/home/YOUR_USERNAME/pyclaudius/.venv/bin/pyclaudius
Restart=on-failure
RestartSec=10

# Environment
Environment=HOME=/home/YOUR_USERNAME
# opencode's installer puts the binary in ~/.opencode/bin
Environment=PATH=/home/YOUR_USERNAME/.opencode/bin:/home/YOUR_USERNAME/.local/bin:/usr/local/bin:/usr/bin:/bin

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pyclaudius

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
# opencode needs its own state dirs writable: sessions live in
# ~/.local/share/opencode, so missing these silently breaks session continuity
# under ProtectHome=read-only.
# The '-' prefix means "ignore if absent" — without it systemd refuses to start
# the unit at all when a directory is missing. Create them before first start
# (see README), otherwise opencode cannot write sessions under ProtectHome.
ReadWritePaths=/home/YOUR_USERNAME/.pyclaudius-relay -/home/YOUR_USERNAME/.local/share/opencode -/home/YOUR_USERNAME/.local/state/opencode -/home/YOUR_USERNAME/.config/opencode -/home/YOUR_USERNAME/.cache/opencode
PrivateTmp=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallArchitectures=native
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target

# SETUP INSTRUCTIONS:
#
# 1. Replace all YOUR_USERNAME with your actual Linux username
#
# 2. Copy to systemd:
#    sudo cp daemon/pyclaudius.service /etc/systemd/system/
#
# 3. Reload systemd:
#    sudo systemctl daemon-reload
#
# 4. Enable (start on boot):
#    sudo systemctl enable pyclaudius
#
# 5. Start:
#    sudo systemctl start pyclaudius
#
# 6. Check status:
#    sudo systemctl status pyclaudius
#
# 7. View logs:
#    journalctl -u pyclaudius -f
#
# 8. Stop:
#    sudo systemctl stop pyclaudius
#
# 9. Disable:
#    sudo systemctl disable pyclaudius

[Unit]
Description=Claude CLI in tmux for the pyclaudius keepalive
After=network-online.target
Wants=network-online.target

[Service]
# tmux new-session -d forks a server and the client exits, hence forking.
Type=forking
# UPDATE THIS: Your username
User=YOUR_USERNAME
# A dedicated folder you trust once (see setup below). In an untrusted
# folder claude opens with the trust dialog, whose default "No, exit"
# makes the keepalive's Enter quit claude.
WorkingDirectory=/home/YOUR_USERNAME/claude-keepalive
Environment=HOME=/home/YOUR_USERNAME
Environment=PATH=/home/YOUR_USERNAME/.local/bin:/usr/local/bin:/usr/bin:/bin
# The session name must equal TMUX_SESSION in .env.
ExecStart=/usr/bin/tmux new-session -d -s claude claude
# "-": when the server already died, kill-session fails with
# "no server running"; that is not a stop failure.
ExecStop=-/usr/bin/tmux kill-session -t claude
# claude exits -> session closes -> tmux server exits -> start it again.
Restart=always
RestartSec=10
# No PrivateTmp: the socket must land in the real /tmp/tmux-<UID>,
# which pyclaudius.service bind-mounts.

[Install]
WantedBy=multi-user.target

# SETUP INSTRUCTIONS:
#
# Only needed if you set TMUX_SESSION. Install it together with
# pyclaudius.service, which starts after this unit.
#
# 1. Stop any tmux server you started by hand (tmux kill-server).
#    Otherwise this unit joins that server, owns no process and loops.
#
# 2. Create the folder claude runs in:
#    mkdir -p ~/claude-keepalive
#
# 3. Install (replaces YOUR_USERNAME with your login name):
#    sed "s/YOUR_USERNAME/$USER/g" daemon/pyclaudius-tmux.service | sudo tee /etc/systemd/system/pyclaudius-tmux.service > /dev/null
#
# 4. Reload systemd and enable (start on boot):
#    sudo systemctl daemon-reload
#    sudo systemctl enable --now pyclaudius-tmux
#
# 5. Trust the folder once. On the first start claude shows the trust
#    dialog; choose "Yes, I trust this folder", then detach with Ctrl-b d:
#    tmux attach -t claude
#    Check: after sudo systemctl restart pyclaudius-tmux, claude must show
#    its prompt, not the dialog.
#
# Use only one tmux unit for this session. If you already have your own
# (e.g. tmux-claude.service), disable it: two units fight over the session.
#
# Note: any other tmux session you open as this user joins this server
# and dies when the unit stops or restarts.
